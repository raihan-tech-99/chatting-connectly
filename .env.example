# ─────────────────────────────────────────────────────────────────────────────
# Connectly – Environment Variables Reference
# Copy this file to .env (never commit .env to version control)
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Full JDBC URL (Neon example shown; replace with your own)
DATABASE_URL=jdbc:postgresql://ep-xxx.us-east-2.aws.neon.tech/connectly?sslmode=require
DATABASE_USERNAME=connectly_user
DATABASE_PASSWORD=your_strong_password_here

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=replace-with-at-least-256-bit-random-secret-key-do-not-use-this-in-production
JWT_EXPIRATION_MS=86400000       # 24 hours in milliseconds

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://connectly.pages.dev

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── File Upload ───────────────────────────────────────────────────────────────
# Directory where uploaded images are stored (absolute or relative path)
UPLOAD_DIR=uploads

# ── WebRTC / TURN (optional but recommended for cross-network calls) ──────────
# See DEPLOYMENT.md for free-tier TURN providers and self-hosted options
TURN_URLS=turn:openrelay.metered.ca:80
TURN_USERNAME=openrelayproject
TURN_CREDENTIAL=openrelayproject

# ── Spring profile (local | default | prod) ───────────────────────────────────
SPRING_PROFILES_ACTIVE=default
